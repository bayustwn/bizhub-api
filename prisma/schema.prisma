generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model berkas {
  id             String   @id @db.VarChar(50)
  nama           String   @db.VarChar(255)
  nama_file      String   @db.VarChar(255)
  url            String   @db.Text
  id_tugas       String   @db.VarChar(50)
  tanggal_upload DateTime @default(now()) @db.Timestamp(0)
  tugas          tugas    @relation(fields: [id_tugas], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "berkas_ibfk_1")

  @@index([id_tugas], map: "id_tugas")
}

model tugas {
  id             String           @id @db.VarChar(50)
  judul          String           @db.VarChar(255)
  brief          String?          @db.Text
  kuantitas      Int?
  deadline       DateTime?        @db.DateTime(0)
  terlambat      Boolean          @default(false)
  status         String?          @db.VarChar(50)
  id_admin       String?          @db.VarChar(50)
  tanggal_dibuat DateTime?        @default(now()) @db.DateTime(0)
  tanggal_diubah DateTime?        @db.DateTime(0)
  berkas         berkas[]
  pengguna       pengguna?        @relation(fields: [id_admin], references: [id], onUpdate: Restrict, map: "tugas_ibfk_1")
  tugas_pengguna tugas_pengguna[]

  @@index([id_admin], map: "id_admin")
}

model pengguna {
  id               String             @id @db.VarChar(50)
  nama             String             @db.VarChar(100)
  email            String             @unique(map: "email") @db.VarChar(100)
  posisi           String             @db.VarChar(255)
  password         String             @db.VarChar(100)
  token_notifikasi token_notifikasi[]
  tugas            tugas[]
  tugas_pengguna   tugas_pengguna[]
}

model tugas_pengguna {
  id       String   @id @db.VarChar(50)
  id_user  String   @db.VarChar(50)
  id_tugas String   @db.VarChar(50)
  pengguna pengguna @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tugas_pengguna_ibfk_1")
  tugas    tugas    @relation(fields: [id_tugas], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tugas_pengguna_ibfk_2")

  @@index([id_tugas], map: "id_tugas")
  @@index([id_user], map: "tugas_pengguna_ibfk_1")
}

model token_notifikasi {
  token    String   @id @db.VarChar(255)
  id_user  String   @db.VarChar(50)
  pengguna pengguna @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "token_notifikasi_ibfk_1")

  @@index([id_user], map: "id_user")
}

model posisi {
  id     String @id @db.VarChar(255)
  posisi String
}
